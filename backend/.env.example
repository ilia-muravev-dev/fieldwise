# Copy to backend/.env — the file is gitignored.
DATABASE_URL=postgresql+psycopg://fieldwise:fieldwise@localhost:5432/fieldwise
REDIS_URL=redis://localhost:6379/0
STORAGE_URL=file://./data/storage
# anthropic | openai | fake   (openai = any OpenAI-compatible endpoint, see below)
LLM_PROVIDER=anthropic
# off | record | replay
LLM_CASSETTE_MODE=off
DEFAULT_MODEL=claude-sonnet-5
DEFAULT_EFFORT=low
# Paste your key here; it is read by the Anthropic SDK.
ANTHROPIC_API_KEY=

# --- Free options for trying the pipeline (LLM_PROVIDER=openai) ---
# OpenRouter free vision models (rate-limited): https://openrouter.ai/models?q=free
#   OPENAI_BASE_URL=https://openrouter.ai/api/v1
#   OPENAI_API_KEY=sk-or-...
#   DEFAULT_MODEL=qwen/qwen3.8-27b:free
# A local Ollama model (brew install ollama; ollama pull qwen2.5vl:7b):
#   OPENAI_BASE_URL=http://localhost:11434/v1        (from Docker: http://host.docker.internal:11434/v1)
#   OPENAI_API_KEY=ollama
#   DEFAULT_MODEL=qwen2.5vl:7b
OPENAI_BASE_URL=https://openrouter.ai/api/v1
OPENAI_API_KEY=
