# Copy to backend/.env — the file is gitignored.
DATABASE_URL=postgresql+psycopg://fieldwise:fieldwise@localhost:5432/fieldwise
REDIS_URL=redis://localhost:6379/0
STORAGE_URL=file://./data/storage
# anthropic | fake
LLM_PROVIDER=anthropic
# off | record | replay
LLM_CASSETTE_MODE=off
DEFAULT_MODEL=claude-sonnet-5
DEFAULT_EFFORT=low
# Paste your key here; it is read by the Anthropic SDK.
ANTHROPIC_API_KEY=
